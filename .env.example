# ==============================================================================
# Traffic Pulse - Environment Configuration Template
# Copy to .env and adjust paths as appropriate
# ==============================================================================

# Data Directory containing the organizer's synthetic traffic dataset
DATA_DIR=./synthetic_traffic_data
MODELS_DIR=./models
CACHE_DIR=./cache

# Server Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=False
CORS_ORIGINS=*

# Ingestion & Time-Space Grid Resolution
INTERVAL_SECONDS=300
DEFAULT_START_TIMESTAMP=2024-01-01 16:00:00
DEFAULT_STREAM_SPEED=1.0

# Detection & AI Thresholds
ANOMALY_SPEED_DROP_THRESHOLD=0.30
ANOMALY_OCCUPANCY_SPIKE_THRESHOLD=0.20
INCIDENT_CONFIDENCE_THRESHOLD=0.60
ISOLATION_FOREST_CONTAMINATION=0.04

# Forecasting Configuration
FORECAST_HORIZONS=15,30,45,60
ST_GNN_HIDDEN_DIM=64
ST_GNN_EPOCHS=15
