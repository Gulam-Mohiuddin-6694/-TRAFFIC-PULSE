# ==============================================================================
# Traffic Pulse: Real-Time Network AI & Traffic Operations Center (TOC)
# Environment Configuration
# ==============================================================================

# Data Paths
DATA_DIR=C:\Autonomous Traffic Flow Optimization & Road-Safety Response Agents\synthetic_traffic_data\synthetic_traffic_data
MODELS_DIR=models
CACHE_DIR=cache

# Server & Network Settings
HOST=127.0.0.1
PORT=8000
DEBUG=False
CORS_ORIGINS=*

# Traffic Simulation & Streaming Engine
INTERVAL_SECONDS=300
DEFAULT_START_TIMESTAMP=2024-01-01 16:00:00
DEFAULT_STREAM_SPEED=1.0

# AI & Anomaly Thresholds
ANOMALY_SPEED_DROP_THRESHOLD=0.30
ANOMALY_OCCUPANCY_SPIKE_THRESHOLD=0.20
INCIDENT_CONFIDENCE_THRESHOLD=0.60
ISOLATION_FOREST_CONTAMINATION=0.04

# Forecasting Settings
FORECAST_HORIZONS=15,30,45,60
ST_GNN_HIDDEN_DIM=64
ST_GNN_EPOCHS=15
